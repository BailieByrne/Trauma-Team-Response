// Runtime settings mirrored from CET Native Settings UI.
// Values are stored in PreventionSpawnSystem for the current game session.
public class TraumaTeamConfig {
  public let enabled: Bool = true;

  public let corpoChance: Int32 = 30;

  public let mercChance: Int32 = 12;

  public let gangChance: Int32 = 4;

  public let fringeChance: Int32 = 1;

  public let silverWeight: Int32 = 60;

  public let goldWeight: Int32 = 30;

  public let silverDelay: Int32 = 60;

  public let goldDelay: Int32 = 45;

  public let platinumDelay: Int32 = 30;
}
